{
  "name": "calibrated",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:http": "vite --config vite.http.config.ts --host 0.0.0.0",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node scripts/check-browser.mjs",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "voices:generate": "node scripts/generate-voices.mjs",
    "scan:prepare": "node scripts/prepare-scan.mjs",
    "scan:extract-wall": "node scripts/extract-wall.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
